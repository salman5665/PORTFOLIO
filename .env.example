# ============================================================
# Environment Variables - Salman Portfolio
# Copy this file to .env.local and fill in your values
# ============================================================

# Supabase (Required)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend Email API (for contact form)
RESEND_API_KEY=your_resend_api_key
CONTACT_EMAIL_TO=mspatel920@gmail.com

# GitHub API (for contribution stats)
GITHUB_TOKEN=your_github_personal_access_token
NEXT_PUBLIC_GITHUB_USERNAME=salman5665

# Admin Credentials (hashed in Supabase Auth)
ADMIN_EMAIL=mspatel920@gmail.com

# Optional: Analytics
NEXT_PUBLIC_GA_ID=
